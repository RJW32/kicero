# SendGrid Contact Form Configuration
SENDGRID_API_KEY="SG.xxxxx"
CONTACT_TO_EMAIL="info@kicero.co.uk"
# Internal notification recipient for /api/questionnaire (SendGrid "to"). Contact form uses CONTACT_TO_EMAIL.
QUESTIONNAIRE_TO_EMAIL="forms@kicero.co.uk"
CONTACT_FROM_EMAIL="noreply@kicero.co.uk"
CONTACT_FROM_NAME="Kicero Website Questionnaire"
# Optional — canonical website origin for questionnaire emails (client-upload links). Production uses wrangler.toml PUBLIC_SITE_URL.
PUBLIC_SITE_URL=""
# Strong random secret (e.g. openssl rand -hex 32); used to mint signed client upload links and validate presigned puts. Configure in production via wrangler: wrangler secret put CLIENT_UPLOAD_SECRET
CLIENT_UPLOAD_SECRET=""
# Direct-to-R2 uploads (required in production for large files / videos). After creating an
# R2 API token, add the same values in the Workers dashboard (or wrangler secret / vars).
# R2 CORS applies to PUTs aimed at *.r2.cloudflarestorage.com (browser uploads), not this repo file alone:
# 1. Cloudflare Dashboard → R2 → bucket kicero-client-uploads → Settings → CORS → paste JSON → Save,
#    or: npx wrangler r2 bucket cors set kicero-client-uploads --file scripts/r2-cors-policy.example.json
# 2. npx wrangler r2 bucket cors list kicero-client-uploads  (confirm rules match what you expect)
# 3. Origins must match EXACTLY (scheme + host + port): add http://192.168.x.x:3000 if you open the site via LAN/network URL from Vite
#    (localhost and 127.0.0.1 are different origins — both are listed in scripts/r2-cors-policy.example.json)
# 4. If uploads use a PUBLIC custom domain as R2_PUBLIC_BASE (not Worker proxy), purge Cloudflare CDN cache after CORS changes (R2 CORS docs)
# See scripts/r2-cors-policy.example.json — include OPTIONS (browser preflight for Content-Type on PUT).
# Files under ~95 MB can upload via same-origin POST (Worker → R2) when direct PUT is blocked.
R2_PUBLIC_BASE="https://uploads.kicero.co.uk"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="kicero-client-uploads"
# Optional — EU / FedRAMP jurisdiction buckets only (see Cloudflare R2 docs).
# R2_S3_ENDPOINT="https://<account_id>.eu.r2.cloudflarestorage.com"
LOCAL_UPLOAD_DIR="uploads"

# Analytics (optional — leave blank to disable)
# Privacy-friendly Plausible analytics — set this to your live domain
VITE_PLAUSIBLE_DOMAIN=""
# Override script URL if you self-host Plausible
VITE_PLAUSIBLE_SCRIPT="https://plausible.io/js/script.js"
# Microsoft Clarity (free heatmaps + session recordings)
VITE_CLARITY_PROJECT_ID=""

# Show the development disclaimer banner on the homepage
# Set to "true" while the site is still considered a work in progress
VITE_SHOW_DEV_DISCLAIMER="false"
