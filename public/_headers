# Cloudflare Pages / Workers Assets reads this file to set response headers.
# More specific paths must come first.
#
# Hashed asset bundles (Vite emits content-hashed filenames in /assets/*) are
# safe to cache aggressively and forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted Gotham fonts ship under /assets/ already, so the rule above
# covers them. Logo + manifest get a moderate cache.
/kicero-logo.png
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/og-image.svg
  Cache-Control: public, max-age=604800
/og-image.png
  Cache-Control: public, max-age=604800
/site.webmanifest
  Cache-Control: public, max-age=604800
  Content-Type: application/manifest+json

# Sitemap + robots are critical-path SEO files; let them refresh quickly.
/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8
/robots.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

# HTML responses (the default) must revalidate every load so updates ship
# instantly; security headers apply site-wide.
/*
  Cache-Control: public, max-age=0, must-revalidate
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
